# ============================================
# Isha's Return Gifts - Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is git-ignored.
# ============================================

# Django
# Generate a fresh key per environment:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=generate-a-new-key-per-environment

# MUST be False in production.
DEBUG=True

# Comma-separated. In production use your real domain, never "*".
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated, must include scheme. Production: https://yourdomain.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database — blank uses SQLite (dev only).
# Production (Supabase): Project Settings -> Database -> Connection string
# -> URI. Use the DIRECT connection (port 5432), not the "Connection pooling"
# one — this app runs on a persistent process, so the pooler isn't needed and
# its transaction-mode caveats don't apply.
DATABASE_URL=

# Supabase Storage — product/category/testimonial images. Leave all three
# blank to use local disk storage (dev default). Storage -> your bucket ->
# Settings gives the endpoint; S3 access keys are under
# Storage -> S3 Connection -> "New access key".
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
# Optional — defaults shown.
SUPABASE_S3_BUCKET=media
SUPABASE_S3_REGION=ap-south-1

# Razorpay (dashboard.razorpay.com → Settings → API Keys)
# Use rzp_test_* keys in dev, rzp_live_* in production.
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere

# Email (Gmail SMTP — requires a 16-digit App Password, not your login password)
EMAIL_HOST_USER=your_gmail@gmail.com
EMAIL_HOST_PASSWORD=your_16_digit_app_password
ADMIN_EMAIL=your_gmail@gmail.com
DEFAULT_FROM_EMAIL=Isha's Return Gifts <your_gmail@gmail.com>

# Dev-only escape hatch for machines behind a TLS-intercepting proxy (corporate
# VPN, antivirus). Insecure — ignored entirely when DEBUG=False.
DISABLE_SSL_VERIFY=False

# Seconds to wait on the SMTP server before giving up. Mail is sent inside the
# request, so this bounds how long a slow mail server can hold a page load.
EMAIL_TIMEOUT=10
